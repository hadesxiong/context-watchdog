# 落地页的「部署身份」——不是秘密，而是**这一份部署**的参数（.env 已被 .gitignore 覆盖）：
# fork 之后不该静默继承别人的域名、商店页或备案号。
# 用法：复制成 apps/site/.env 后按需填写；留空的键都有明确的降级行为，shell 同名变量可覆盖本文件。

# 站点部署地址（必须是 https）。可带子路径：SITE_URL=https://aa.bb.com/context-watchdog
# 表示站点在 /context-watchdog/ 下 —— 站内链接、静态资源、canonical / hreflang 全由这**一个值**
# 派生（子路径 = 它的 pathname，同时作为 Astro 的 base）。
# 托管时要把 dist 整个挂到该子路径下；robots.txt 只有放在**域名根**才被爬虫读取。
# 留空 = 相对路径 + 根部署（只适合本地预览与 fork）；发布构建加 SITE_REQUIRE_URL=1，缺失即失败。
SITE_URL=

# 商店与桌面端渠道：留空 = 该行显示「即将上架」（不渲染 <a>，不是空 href）；填了必须是 https，否则构建失败。
EDGE_URL=
CWS_URL=
AMO_URL=
WIN_URL=
MAC_URL=

# 中文页的仓库镜像（如 https://gitee.com/owner/context-watchdog）。
# 只影响「阅读源码」与「下载」两处；深度链接与 Issues 固定 GitHub。留空 = 中文页也指向 GitHub。
GITEE_URL=

# 页脚备案号（原文照填，含末尾的「号」与序号）。留空则不渲染该行。
# 例：ICP_BEIAN=粤ICP备2026000000号-1
ICP_BEIAN=
POLICE_BEIAN=

# —— 访问统计（可选，自托管 Umami）——
# WEBSITE_ID 与 SCRIPT_URL 必须同填同空，缺一 = 构建失败；地址须公网可达（访客浏览器
# 加载），内网主机经下方 nginx 反代；未填 = 不注入任何脚本。
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=
# 事件上报基址（data-host-url），留空不输出；如 https://product.bearman.site/umami
UMAMI_HOST_URL=
# data-do-not-track：true / false，留空不输出
UMAMI_DNT=
# 内网 Umami 反代（/umami 配在域名根，不进站点子路径）：
#   location = /umami/script.js { proxy_pass http://100.x.y.z:3000/script.js; proxy_set_header Host $host; }
#   location /umami/api/        { proxy_pass http://100.x.y.z:3000/api/;        proxy_set_header Host $host; }
# 放开后台登录页则改用整段：location /umami/ { proxy_pass http://100.x.y.z:3000/; proxy_set_header Host $host; }
