---
// 感谢墙
//
// 分档排版（人数 → 形态）的理由与规则在 data/supporters.ts 里（含单测）：
//   0 人     → 整个区块不渲染
//   1–3      → spotlight（逐个大方列出）
//   4–20     → 单列
//   21–100   → 网格 + 总数
//   >100     → 最近 30 位 + 总数
//
// 0 人的处理是这个组件最重要的行为：**空列表比没有更难堪**，也容易被读成
// 「没人支持」，所以此时它必须彻底消失，而不是渲染一个空框。
import { dict, type SiteLocale, format } from '@site/i18n'
import { plan } from '@site/data/supporters'

interface Props {
  locale: SiteLocale
}

const { locale } = Astro.props
const d = dict(locale)

const { mode } = plan
const people =
  mode === 'spotlight' || mode === 'list' || mode === 'grid'
    ? plan.people
    : mode === 'recent'
      ? plan.shown
      : []
const total = mode === 'grid' || mode === 'recent' ? plan.total : people.length

const listClass =
  mode === 'spotlight'
    ? 'pg-thanks-spotlight'
    : mode === 'list'
      ? 'pg-thanks-list'
      : 'pg-thanks-grid'
---

{
  mode !== 'hidden' && (
    <section class="pg-section" id="thanks">
      <div class="pg-shell">
        <h2 class="pg-section-title">{d.thanks.title}</h2>
        <p class="pg-lead">{d.thanks.lead}</p>

        <div class={listClass}>
          {people.map((person) => (
            <div class="pg-supporter">
              <div class="pg-supporter-name">{person.name}</div>
              {person.note && <div class="pg-supporter-note">{person.note}</div>}
            </div>
          ))}
        </div>

        {(mode === 'grid' || mode === 'recent') && (
          <p class="pg-thanks-total">
            {format(d.thanks.total, { count: total })}
            {mode === 'recent' && ` · ${format(d.thanks.recent, { shown: people.length })}`}
          </p>
        )}
      </div>
    </section>
  )
}
