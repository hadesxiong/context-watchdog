---
// 单页 9 区块（E3）
//
// 顺序即叙事：是什么 → 看一眼 → 怎么做到的 → 凭什么信 →
// 现在什么样 → 谁在支持 → 还有疑问 → 怎么支持。
//
// 两个语言页面共用这一个组件，避免 / 与 /en/ 两处各写一遍结构（结构一旦
// 分叉，两边迟早会长得不一样）。
import { dict, format, type SiteLocale } from '@site/i18n'
import { repoUrl } from '@site/data/links'
import { tests, probes, measuredAt, count } from '@site/data/evidence'
import { supporters } from '@site/data/supporters'
import { extensionVersion } from '@site/data/version'
import Rich from '@site/components/Rich.astro'
import Download from '@site/components/Download.astro'
import Thanks from '@site/components/Thanks.astro'

interface Props {
  locale: SiteLocale
}

const { locale } = Astro.props
const d = dict(locale)

// 支持者数量：0 人时显示一句话而不是一个「0」（0 看起来像失败，而它只是还没开始）
const supporterValue = supporters.length === 0 ? '—' : count(supporters.length)
const supporterLabel = supporters.length === 0 ? d.evidence.supportersNone : d.evidence.supporters
---

<!-- 1. Hero -->
<section class="pg-hero">
  <div class="pg-shell">
    <span class="pg-badge">{d.hero.badge}</span>
    <h1>{d.hero.title}</h1>
    <p>{d.hero.subtitle}</p>
    <div class="pg-actions">
      <a class="pg-btn pg-btn-secondary" href={repoUrl} rel="noopener">{d.hero.secondary}</a>
    </div>
  </div>
</section>

<!-- 2. 下载（紧跟 hero：想装的人不该先读八屏理由） -->
<Download locale={locale} />

<!-- 3. 30 秒演示 -->
<section class="pg-section" id="demo">
  <div class="pg-shell">
    <h2 class="pg-section-title">{d.demo.title}</h2>
    <Rich text={d.demo.caption} class="pg-lead" />

    <div class="pg-demo">
      <div class="pg-demo-body">
        <div>
          <div class="pg-demo-label">{d.demo.before}</div>
          <div class="pg-demo-pane">{d.demo.original}</div>
        </div>
        <div>
          <div class="pg-demo-label">{d.demo.after}</div>
          <div class="pg-demo-pane">
            {
              // 把 <<占位符>> 单独染色，一眼看出「哪些部分被换掉了」。
              // 用 split 保留分隔符，比 set:html 安全（无注入面）。
              d.demo.redacted.split(/(<<[^>]+>>)/g).map((chunk) =>
                chunk.startsWith('<<') ? <span class="pg-ph">{chunk}</span> : chunk
              )
            }
          </div>
        </div>
      </div>
      <div class="pg-demo-placeholder">
        {d.demo.placeholder} · {d.demo.placeholderNote}
      </div>
    </div>
  </div>
</section>

<!-- 4. 工作原理 -->
<section class="pg-section" id="how">
  <div class="pg-shell">
    <h2 class="pg-section-title">{d.how.title}</h2>
    <p class="pg-lead">{d.how.lead}</p>

    <div class="pg-grid pg-grid-3">
      {
        d.how.steps.map((step, index) => (
          <div class="pg-card">
            <div class="pg-step-index">{index + 1}</div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 5. 可核验的隐私承诺 -->
<section class="pg-section" id="privacy">
  <div class="pg-shell">
    <h2 class="pg-section-title">{d.privacy.title}</h2>
    <p class="pg-lead">{d.privacy.lead}</p>

    <div class="pg-grid pg-grid-2">
      {
        d.privacy.items.map((item) => (
          <div class="pg-card">
            <div class="pg-claim">{item.claim}</div>
            <p class="pg-how">{item.how}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 6. 证据 -->
<section class="pg-section" id="evidence">
  <div class="pg-shell">
    <h2 class="pg-section-title">{d.evidence.title}</h2>
    <p class="pg-lead">{d.evidence.lead}</p>

    <div class="pg-stats">
      <div class="pg-stat">
        <div class="pg-stat-value">{count(tests)}</div>
        <div class="pg-stat-label">{d.evidence.tests}</div>
      </div>
      <div class="pg-stat">
        <div class="pg-stat-value">{probes}</div>
        <div class="pg-stat-label">{d.evidence.probes}</div>
      </div>
      <div class="pg-stat">
        <div class="pg-stat-value">v{extensionVersion}</div>
        <div class="pg-stat-label">{d.evidence.version}</div>
      </div>
      <div class="pg-stat">
        <div class="pg-stat-value">Apache-2.0</div>
        <div class="pg-stat-label">{d.evidence.license}</div>
      </div>
      <div class="pg-stat">
        <div class="pg-stat-value">{supporterValue}</div>
        <div class="pg-stat-label">{supporterLabel}</div>
      </div>
    </div>

    <p class="pg-note">{format(d.evidence.measured, { date: measuredAt })}</p>
  </div>
</section>

<!-- 8. 感谢墙（0 人时整个区块不渲染） -->
<Thanks locale={locale} />

<!-- 9. FAQ -->
<section class="pg-section" id="faq">
  <div class="pg-shell">
    <h2 class="pg-section-title">{d.faq.title}</h2>

    <div class="pg-faq">
      {
        d.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- 10. 打赏 -->
<section class="pg-section" id="donate">
  <div class="pg-shell">
    <h2 class="pg-section-title">{d.donate.title}</h2>
    <p class="pg-lead">{d.donate.lead}</p>

    <div class="pg-donate">
      <div class="pg-qr">{d.donate.qrPlaceholder}</div>
      <div class="pg-card">
        <p>{d.donate.body}</p>
      </div>
    </div>
  </div>
</section>
