---
// 单页 9 区块（E3）
//
// 顺序即叙事：是什么 → 看一眼 → 怎么做到的 → 用什么识别 →
// 凭什么信 → 谁在支持 → 还有疑问 → 怎么支持。
//
// 两个语言页面共用这一个组件，避免 / 与 /en/ 两处各写一遍结构（结构一旦
// 分叉，两边迟早会长得不一样）。
import { dict, type SiteLocale } from '@site/i18n'
import { repoUrlFor, donateQrAlipay, donateQrWechat } from '@site/data/links'
import Rich from '@site/components/Rich.astro'
import Download from '@site/components/Download.astro'
import Thanks from '@site/components/Thanks.astro'

interface Props {
  locale: SiteLocale
}

const { locale } = Astro.props
const d = dict(locale)
---

<!-- 1. Hero -->
<section class="pg-hero">
  <div class="pg-shell">
    <span class="pg-badge">{d.hero.badge}</span>
    <h1>{d.hero.title}</h1>
    <p>{d.hero.subtitle}</p>
    <div class="pg-actions">
      <a class="pg-btn pg-btn-secondary" href={repoUrlFor(locale)} rel="noopener">{d.hero.secondary}</a>
    </div>
  </div>
</section>

<!-- 2. 下载（紧跟 hero：想装的人不该先读八屏理由） -->
<Download locale={locale} />

<!-- 3. 30 秒演示 -->
<section class="pg-section" id="demo">
  <div class="pg-shell">
    <h2 class="pg-section-title">{d.demo.title}</h2>
    <Rich text={d.demo.caption} class="pg-lead" />

    <div class="pg-demo">
      {
        d.demo.cases.map((c) => (
          <div class="pg-demo-case">
            <div class="pg-demo-case-title">{c.label}</div>
            <div class="pg-demo-body">
              <div>
                <div class="pg-demo-label">{d.demo.before}</div>
                <div class="pg-demo-pane">{c.original}</div>
              </div>
              <div>
                <div class="pg-demo-label">{c.timing}</div>
                <div class="pg-demo-pane">
                  {
                    // 把 <<占位符>> 单独染色，一眼看出「哪些部分被换掉了」。
                    // 用 split 保留分隔符，比 set:html 安全（无注入面）。
                    c.redacted.split(/(<<[^>]+>>)/g).map((chunk) =>
                      chunk.startsWith('<<') ? <span class="pg-ph">{chunk}</span> : chunk
                    )
                  }
                </div>
              </div>
            </div>
            <div class="pg-demo-note">{c.note}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 4. 工作原理 -->
<section class="pg-section" id="how">
  <div class="pg-shell">
    <h2 class="pg-section-title">{d.how.title}</h2>
    <p class="pg-lead">{d.how.lead}</p>

    <div class="pg-grid pg-grid-3">
      {
        d.how.steps.map((step, index) => (
          <div class="pg-card">
            <div class="pg-step-head">
              <div class="pg-step-index">{index + 1}</div>
              <h3>{step.title}</h3>
            </div>
            <p>{step.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 5. 识别引擎（正则/AI 两档的实现层：工作原理只讲场景流程，实现细节收在这里） -->
<section class="pg-section" id="engine">
  <div class="pg-shell">
    <h2 class="pg-section-title">{d.engine.title}</h2>
    <p class="pg-lead">{d.engine.lead}</p>

    <div class="pg-grid pg-grid-2">
      {
        d.engine.tiers.map((tier) => (
          <div class="pg-card">
            <h3>{tier.title}</h3>
            <p>{tier.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 6. 可核验的隐私承诺 -->
<section class="pg-section" id="privacy">
  <div class="pg-shell">
    <h2 class="pg-section-title">{d.privacy.title}</h2>
    <p class="pg-lead">{d.privacy.lead}</p>

    <div class="pg-grid pg-grid-2">
      {
        d.privacy.items.map((item) => (
          <div class="pg-card">
            <div class="pg-claim">{item.claim}</div>
            <p class="pg-how">{item.how}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 7. 感谢墙（0 人时整个区块不渲染） -->
<Thanks locale={locale} />

<!-- 8. FAQ -->
<section class="pg-section" id="faq">
  <div class="pg-shell">
    <h2 class="pg-section-title">{d.faq.title}</h2>

    <div class="pg-faq">
      {
        d.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- 9. 打赏：单卡——左两张收款码（支付宝 / 微信），右整段说明（含免费声明与「不解锁任何内容」） -->
<section class="pg-section" id="donate">
  <div class="pg-shell">
    <h2 class="pg-section-title">{d.donate.title}</h2>

    <div class="pg-card pg-donate">
      <div class="pg-donate-codes">
        {
          [
            { label: d.donate.alipay, src: donateQrAlipay },
            { label: d.donate.wechat, src: donateQrWechat }
          ].map((code) => (
            <figure class="pg-qr">
              {code.src ? (
                <>
                  <img
                    class="pg-qr-img"
                    src={code.src}
                    alt={`${code.label} ${d.donate.qrAlt}`}
                    width="180"
                    height="180"
                  />
                  <figcaption class="pg-qr-label">{code.label}</figcaption>
                </>
              ) : (
                <div class="pg-qr-missing">{code.label}</div>
              )}
            </figure>
          ))
        }
      </div>

      <div class="pg-donate-body">
        <p>{d.donate.body}</p>
      </div>
    </div>
  </div>
</section>
