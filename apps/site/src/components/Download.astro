---
// 安装渠道区块
//
// 形态：VS Code / GitHub 式下载按钮 + 下拉面板（零 JS，details/summary，
// 与 FAQ 同一套开合语言）。按钮面分「动作区（↓ + 分组名）」与「caret 区（▾）」，
// 两区以细线分隔——分体按钮的视觉语言，但整枚 summary 都是开合热区：
// 无 JS 时「点外面关闭浮层」做不到，所以面板内联展开而不是绝对定位浮层。
//
// 关键取舍不变：商店没上架时**不渲染一个能点但打不开的链接**——未上架渠道
// 渲染成 aria-disabled 行 +「即将上架」标签，而不是猜一个 URL 填进去。
// 状态本身不写在这里，全部来自 src/data/links.json（构建期校验，见 links.ts）。
//
// 面板内的渠道行不带边框（ghost 行）：外层面板的描边已是唯一一圈——卡中套卡
// （shadcn 也避免）在 GitHub 式下拉里同样不成立。
//
// GitHub 源码行指 Release 页：手动安装的 zip 与步骤都在那（页面上不再抄步骤）。
import { dict, type SiteLocale } from '@site/i18n'
import { storeChannels, appChannels, manualChannel } from '@site/data/links'

interface Props {
  locale: SiteLocale
}

const { locale } = Astro.props
const d = dict(locale)

const labels: Record<string, string> = {
  cws: d.download.cws,
  edge: d.download.edge,
  amo: d.download.amo,
  win: d.download.win,
  mac: d.download.mac,
  manual: d.download.manual
}

// 两个下载按钮 = 插件（三家商店 + GitHub 源码兜底）与桌面应用（Windows / macOS）
const groups = [
  {
    label: d.download.plugin,
    items: [...storeChannels, manualChannel(locale)]
  },
  { label: d.download.app, items: appChannels }
]
---

<section class="pg-section" id="download">
  <div class="pg-shell">
    <h2 class="pg-section-title">{d.download.title}</h2>

    <div class="pg-install">
      {
        groups.map((group) => (
          <details class="pg-dl">
            <summary class="pg-dl-btn">
              <span class="pg-dl-main"><span aria-hidden="true">↓</span> {group.label}</span>
              <span class="pg-dl-caret" aria-hidden="true">▾</span>
            </summary>
            <div class="pg-dl-panel">
              <div class="pg-install-items">
                {group.items.map((item) =>
                  item.available ? (
                    <a class="pg-channel" href={item.url} rel="noopener">
                      <span class="pg-channel-name">{labels[item.key] ?? item.key}</span>
                      <span class="pg-tag pg-tag-ok" aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <span class="pg-channel" aria-disabled="true">
                      <span class="pg-channel-name">{labels[item.key] ?? item.key}</span>
                      <span class="pg-tag">{d.download.pending}</span>
                    </span>
                  )
                )}
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
