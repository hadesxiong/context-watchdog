---
// 安装渠道区块
//
// 形态：VS Code / GitHub 式下载按钮 + 下拉面板（零 JS，details/summary，
// 与 FAQ 同一套开合语言）。按钮面分「动作区（图标 + 分组名）」与「caret 区（▾）」，
// 两区以细线分隔——分体按钮的视觉语言，但整枚 summary 都是开合热区：
// 无 JS 时「点外面关闭浮层」做不到，所以面板内联展开而不是绝对定位浮层。
//
// 关键取舍不变：商店没上架时**不渲染一个能点但打不开的链接**——未上架渠道
// 渲染成 aria-disabled 行 +「即将上架」标签，而不是猜一个 URL 填进去。
// 状态本身不写在这里，全部来自 src/data/links.json（构建期校验，见 links.ts）。
//
// 面板内的渠道行不带边框（ghost 行）：外层面板的描边已是唯一一圈——卡中套卡
// （shadcn 也避免）在 GitHub 式下拉里同样不成立。
//
// GitHub 源码行指 Release 页：手动安装的 zip 与步骤都在那（页面上不再抄步骤）。
//
// 图标（内联 SVG，零请求）：
// - 两枚主按钮是**复合含义**图标——插件 = 拼图块（浏览器扩展的通用符号）+ 下箭头，
//   应用 = 显示器 + 下箭头；随按钮文字色（currentColor）。
// - 渠道行带各自的品牌标记（Chrome/Edge/Firefox 徽记、Octocat、Windows 四格、Apple），
//   仅作「在哪里可用」的兼容性指示（指名性使用）；几何徽记（Chrome 三扇区、Windows
//   四格）按主色手绘，文字类徽记（Octocat、Apple）走 currentColor 随灰阶。
import { dict, type SiteLocale } from '@site/i18n'
import { storeChannels, appChannels, manualChannel } from '@site/data/links'

interface Props {
  locale: SiteLocale
}

const { locale } = Astro.props
const d = dict(locale)

const labels: Record<string, string> = {
  cws: d.download.cws,
  edge: d.download.edge,
  amo: d.download.amo,
  win: d.download.win,
  mac: d.download.mac,
  manual: d.download.manual
}

// 拼图块 + 下箭头（插件下载）。拼图轮廓：上缘凹、右缘凸、下缘凹、左缘凸（经典咬合形）
const iconPuzzleDownload = `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h5.5a2 2 0 0 0 4 0H19v5.5a2 2 0 0 1 0 4V19h-5.5a2 2 0 0 0-4 0H4v-5.5a2 2 0 0 0 0-4V4z"/><path d="M11.5 9v4.5m0 0-1.8-1.8m1.8 1.8 1.8-1.8"/></svg>`

// 显示器 + 下箭头（应用下载）
const iconAppDownload = `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.75" y="4.5" width="18.5" height="12" rx="2"/><path d="M9 20.25h6M12 16.5v3.75M12 7.75v4.5m0 0-1.8-1.8m1.8 1.8 1.8-1.8"/></svg>`

// Chrome 徽记：红上/黄右/绿左三扇区 + 白环 + 蓝心（扇区弧向已逐一核过 sweep 方向）
const iconChrome = `<svg viewBox="0 0 24 24" width="15" height="15"><path fill="#ea4335" d="M3.34 7A10 10 0 0 1 20.66 7L12 12Z"/><path fill="#fbbc05" d="M20.66 7A10 10 0 0 1 12 22L12 12Z"/><path fill="#34a853" d="M12 22A10 10 0 0 1 3.34 7L12 12Z"/><circle cx="12" cy="12" r="5.2" fill="#fff"/><circle cx="12" cy="12" r="4.2" fill="#4285f4"/></svg>`

// Edge 徽记：蓝-青渐变圆 + 白色波纹（Edge 的签名波形）
const iconEdge = `<svg viewBox="0 0 24 24" width="15" height="15"><defs><linearGradient id="cw-ed" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#0c59a4"/><stop offset="1" stop-color="#35c1f1"/></linearGradient></defs><circle cx="12" cy="12" r="10" fill="url(#cw-ed)"/><path fill="#fff" d="M5.6 13.7c1.1-4.2 5-6.8 9.5-6.4-3.6.1-6.6 2-8.2 5.1-.9 1.7-.5 3.3 1 3.3 1.9 0 3.3-1.6 4.6-3.3.9-1.2 2-2.1 3.3-2.6-3.5-1.3-9 .4-10.2 3.9z" opacity=".92"/></svg>`

// Firefox 徽记：黄→橙→红→紫径向渐变球 + 火焰尾（15px 下渐变球即可辨认）
const iconFirefox = `<svg viewBox="0 0 24 24" width="15" height="15"><defs><radialGradient id="cw-ff" cx=".4" cy=".38" r=".8"><stop offset="0" stop-color="#ffe226"/><stop offset=".38" stop-color="#ff9500"/><stop offset=".72" stop-color="#ff3b30"/><stop offset="1" stop-color="#b5007f"/></radialGradient></defs><circle cx="12" cy="12" r="10" fill="url(#cw-ff)"/><path fill="#fff" d="M6.2 9.5C8.4 5.6 13.5 4 17.4 6.2c-4.2-1.4-8.2.4-9.7 3.9-.8 1.9-.3 3.6 1.2 3.6 1.7 0 2.9-1.4 3.9-2.9.7-1 1.5-1.8 2.5-2.4-3-1.9-8.4-.5-9.1 3.1z" opacity=".35"/></svg>`

// GitHub Octocat（随 currentColor 走灰阶）
const iconGithub = `<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23a11.5 11.5 0 0 1 3-.405c1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`

// Windows 四格（透视微倾，#0078d4 主色）
const iconWindows = `<svg viewBox="0 0 24 24" width="15" height="15" fill="#0078d4"><path d="M3 5.5 10.8 4.4v7.1H3zm8.8-1.2L21 3v8.5h-9.2zM3 12.5h7.8v7.1L3 18.5zm8.8 0H21V21l-9.2-1.3z"/></svg>`

// Apple 徽记（随 currentColor 走灰阶）
const iconApple = `<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zm.082-2.35c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg>`

const channelIcons: Record<string, string> = {
  cws: iconChrome,
  edge: iconEdge,
  amo: iconFirefox,
  manual: iconGithub,
  win: iconWindows,
  mac: iconApple
}

// 两个下载按钮 = 插件（三家商店 + GitHub 源码兜底）与桌面应用（Windows / macOS）
const groups = [
  {
    label: d.download.plugin,
    icon: iconPuzzleDownload,
    items: [...storeChannels, manualChannel(locale)]
  },
  { label: d.download.app, icon: iconAppDownload, items: appChannels }
]
---

<section class="pg-section" id="download">
  <div class="pg-shell">
    <h2 class="pg-section-title">{d.download.title}</h2>

    <div class="pg-install">
      {
        groups.map((group) => (
          <details class="pg-dl">
            <summary class="pg-dl-btn">
              <span class="pg-dl-main">
                <span class="pg-dl-icon" aria-hidden="true" set:html={group.icon} />
                {group.label}
              </span>
              <span class="pg-dl-caret" aria-hidden="true">▾</span>
            </summary>
            <div class="pg-dl-panel">
              <div class="pg-install-items">
                {group.items.map((item) =>
                  item.available ? (
                    <a class="pg-channel" href={item.url} rel="noopener">
                      <span class="pg-channel-label">
                        <span class="pg-channel-icon" aria-hidden="true" set:html={channelIcons[item.key] ?? ''} />
                        <span class="pg-channel-name">{labels[item.key] ?? item.key}</span>
                      </span>
                      <span class="pg-tag pg-tag-ok" aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <span class="pg-channel" aria-disabled="true">
                      <span class="pg-channel-label">
                        <span class="pg-channel-icon" aria-hidden="true" set:html={channelIcons[item.key] ?? ''} />
                        <span class="pg-channel-name">{labels[item.key] ?? item.key}</span>
                      </span>
                      <span class="pg-tag">{d.download.pending}</span>
                    </span>
                  )
                )}
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
