---
// ContextWatchdog 标记：盾牌 + 四点掩码
// 与扩展的 ui/Logo.vue 同一份几何形状（盾牌 = 防护，四点 = 被遮蔽的敏感信息）。
// 颜色走 CSS 变量，因此自动跟随亮/暗主题。
interface Props {
  size?: number
}
const { size = 32 } = Astro.props
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="ContextWatchdog"
>
  <path
    d="M16 2.5 L5 6.5 V15 C5 22.2 9.8 27.9 16 29.5 C22.2 27.9 27 22.2 27 15 V6.5 Z"
    fill="var(--foreground)"></path>
  <path
    d="M16 5.2 L7.6 8.2 V15 C7.6 20.8 11.3 25.6 16 27 C20.7 25.6 24.4 20.8 24.4 15 V8.2 Z"
    stroke="var(--background)"
    stroke-width="1"
    stroke-opacity="0.25"
    fill="none"></path>
  <circle cx="10.5" cy="16" r="1.7" fill="var(--background)"></circle>
  <circle cx="14.2" cy="16" r="1.7" fill="var(--background)"></circle>
  <circle cx="17.9" cy="16" r="1.7" fill="var(--background)"></circle>
  <circle cx="21.6" cy="16" r="1.7" fill="var(--background)"></circle>
</svg>
