---
// 页面外壳：<head>（含 hreflang）、页头导航、页脚
//
// hreflang 是手写的，不是 Astro 生成的：两门语言各是一个独立页面
// （/ 与 /en/），互相之间必须有 alternate 声明，否则搜索引擎会把它们
// 当成重复内容。多语言站点最容易漏掉的一环。
import '@site/styles/global.css'
import Mark from '@site/components/Mark.astro'
import { dict, localePath, otherLocale, localeLabel, type SiteLocale } from '@site/i18n'
import { extensionVersion } from '@site/data/version'
import { repoUrl, releasesUrl, siteUrl, hasCanonicalOrigin } from '@site/data/links'

interface Props {
  locale: SiteLocale
  /** 当前页在该语言下的子路径（不含前导斜杠），如 'privacy'；首页留空 */
  path?: string
}

const { locale, path = '' } = Astro.props
const d = dict(locale)
const other = otherLocale(locale)

// 每个语言下的页面路径。canonical 与 hreflang 必须指向**当前这一页**，
// 而不是恒指向首页——隐私政策页若声明 canonical 为 /，等于告诉搜索引擎
// 这一页是首页的副本，它会直接不收录。
//
// 子页面带尾斜杠：构建用 format: 'directory'，服务的真实地址就是 /privacy/，
// canonical 写的必须是实际地址，否则又变成另一种形式的「指向别处」。
const pagePath = (target: SiteLocale): string =>
  path === '' ? localePath(target) : `${localePath(target)}${path}/`

// 部署后 siteUrl 填好就自动生效；为空时输出相对链接（不做假的 canonical）
const absolute = (p: string): string => (hasCanonicalOrigin ? new URL(p, siteUrl).href : p)
const canonical = absolute(pagePath(locale))

const pageTitle = d.meta.title
---

<!doctype html>
<html lang={d.meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={d.meta.description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <!-- 两门语言互为 alternate；x-default 指向中文版（默认语言在根路径） -->
    <link rel="alternate" hreflang={d.meta.lang} href={absolute(pagePath(locale))} />
    <link
      rel="alternate"
      hreflang={dict(other).meta.lang}
      href={absolute(pagePath(other))}
    />
    <link rel="alternate" hreflang="x-default" href={absolute(pagePath('zh'))} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={d.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={d.meta.ogLocale} />
    <meta name="twitter:card" content="summary" />

    <!-- 主题色跟随系统，与扩展一致（token 文件里就是媒体查询切换） -->
    <meta name="color-scheme" content="light dark" />
  </head>

  <body>
    <header class="pg-header">
      <div class="pg-shell pg-header-inner">
        <a class="pg-brand" href={localePath(locale)}>
          <Mark size={26} />
          <span>PasteGuard</span>
        </a>

        <nav class="pg-nav" aria-label="Sections">
          <a href={`${localePath(locale)}#how`}>{d.nav.how}</a>
          <a href={`${localePath(locale)}#privacy`}>{d.nav.privacy}</a>
          <a href={`${localePath(locale)}#faq`}>{d.nav.faq}</a>
        </nav>

        <a class="pg-lang" href={pagePath(other)} hreflang={dict(other).meta.lang} rel="alternate">
          {localeLabel(other)}
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pg-footer">
      <div class="pg-shell">
        <div class="pg-footer-links">
          <a href={`${localePath(locale)}privacy/`}>{d.footer.privacy}</a>
          <a href={repoUrl}>{d.footer.repo}</a>
          <a href={releasesUrl}>{d.footer.release}</a>
          <a href={`${repoUrl}/blob/main/LICENSE`}>{d.footer.license}</a>
          <a href={`${repoUrl}/blob/main/NOTICE`}>{d.footer.trademark}</a>
          <a href={`${repoUrl}/blob/main/PATENTS.md`}>{d.footer.patents}</a>
          <a href={`${repoUrl}/tree/main/docs/design`}>{d.footer.designDocs}</a>
        </div>
        <p>
          <span class="pg-footer-version">v{extensionVersion}</span> · {d.footer.static}
        </p>
      </div>
    </footer>
  </body>
</html>
