---
// 页面外壳：<head>（含 canonical / hreflang）、页头导航、页脚
// hreflang 与 canonical 是手写的（Astro 不生成）：两门语言各是一个独立页面（/ 与 /en/），
// 互相必须有 alternate 声明，否则搜索引擎当成重复内容 —— 多语言站最容易漏的一环。
import '@site/styles/global.css'
// 品牌锁标与扩展共用仓库根 public/icons 那一份（站点自己的 public/ 只放 favicon/robots），
// 故按 URL 资源引入、构建打进 dist/assets；暗色变体走 prefers-color-scheme（与 token 同源）。
import brandLogo from '../../../../public/icons/logo-1.svg'
import brandLogoDark from '../../../../public/icons/logo-1-dark.svg'
import { dict, localePath, siteBase, otherLocale, localeLabel, type SiteLocale } from '@site/i18n'
import { extensionVersion } from '@site/data/version'
import {
  releasesUrlFor,
  repoUrlFor,
  blobUrl,
  treeUrl,
  siteUrl,
  hasCanonicalOrigin,
  icp,
  police,
  umami
} from '@site/data/links'

interface Props {
  locale: SiteLocale
  /** 当前页在该语言下的子路径（不含前导斜杠），如 'privacy'；首页留空 */
  path?: string
}

const { locale, path = '' } = Astro.props
const d = dict(locale)
const other = otherLocale(locale)

// canonical / hreflang 指向**当前这一页**而非恒指首页：隐私页若写 canonical / 等于自认
// 首页副本，会被直接不收录；子页面带尾斜杠 —— format: 'directory' 下真实地址就是 /privacy/。
const pagePath = (target: SiteLocale): string =>
  path === '' ? localePath(target) : `${localePath(target)}${path}/`

// 站内路径已含部署子路径（localePath 派生自 BASE_URL），这里**只补 origin**：
// 不能用 new URL(p, siteUrl) —— p 以 / 开头时会丢掉 siteUrl 里的子路径，
// canonical 静默错位到域名根。siteUrl 为空时输出相对链接（不做假的 canonical）。
const origin = hasCanonicalOrigin ? new URL(siteUrl).origin : ''
const absolute = (p: string): string => (origin ? origin + p : p)
const canonical = absolute(pagePath(locale))

const pageTitle = d.meta.title

// 属性全部由 UMAMI_* env 派生，enabled=false 时不渲染；
// is:inline：外链标签原样输出，不让 Astro 打包处理
const umamiScriptAttrs: Record<string, string | boolean> | null = umami.enabled
  ? {
      src: umami.scriptUrl,
      defer: true,
      'data-website-id': umami.websiteId,
      ...(umami.hostUrl ? { 'data-host-url': umami.hostUrl } : {}),
      ...(umami.dnt ? { 'data-do-not-track': 'true' } : {})
    }
  : null
---

<!doctype html>
<html lang={d.meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={d.meta.description} />
    <link rel="icon" href={`${siteBase}/favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <!-- 两门语言互为 alternate；x-default 指向中文版（默认语言在根路径） -->
    <link rel="alternate" hreflang={d.meta.lang} href={absolute(pagePath(locale))} />
    <link
      rel="alternate"
      hreflang={dict(other).meta.lang}
      href={absolute(pagePath(other))}
    />
    <link rel="alternate" hreflang="x-default" href={absolute(pagePath('zh'))} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={d.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={d.meta.ogLocale} />
    <meta name="twitter:card" content="summary" />

    <meta name="color-scheme" content="light dark" />

    {
      umamiScriptAttrs && (
        <script is:inline {...umamiScriptAttrs}></script>
      )
    }
  </head>

  <body>
    <header class="pg-header">
      <div class="pg-shell pg-header-inner">
        <a class="pg-brand" href={localePath(locale)}>
          <picture>
            {/* Astro 把 .svg 导入解析成 ImageMetadata（含 src / width / height），尺寸取自文件本身 */}
            <source media="(prefers-color-scheme: dark)" srcset={brandLogoDark.src} />
            <img
              src={brandLogo.src}
              alt="ContextWatchdog"
              width={brandLogo.width}
              height={brandLogo.height}
            />
          </picture>
        </a>

        <nav class="pg-nav" aria-label="Sections">
          <a href={`${localePath(locale)}#how`}>{d.nav.how}</a>
          <a href={`${localePath(locale)}#privacy`}>{d.nav.privacy}</a>
          <a href={`${localePath(locale)}#faq`}>{d.nav.faq}</a>
          <a href={`${localePath(locale)}changelog/`}>{d.nav.changelog}</a>
        </nav>

        <a class="pg-lang" href={pagePath(other)} hreflang={dict(other).meta.lang} rel="alternate">
          {localeLabel(other)}
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pg-footer">
      <div class="pg-shell">
        <div class="pg-footer-links">
          <a href={`${localePath(locale)}privacy/`}>{d.footer.privacy}</a>
          <a href={`${localePath(locale)}changelog/`}>{d.footer.changelog}</a>
          <a href={repoUrlFor(locale)}>{d.footer.repo}</a>
          <a href={releasesUrlFor(locale)}>{d.footer.release}</a>
          <a href={blobUrl('LICENSE')}>{d.footer.license}</a>
          <a href={blobUrl('NOTICE')}>{d.footer.trademark}</a>
          <a href={blobUrl('PATENTS.md')}>{d.footer.patents}</a>
          <a href={treeUrl('docs')}>{d.footer.designDocs}</a>
        </div>
        <p>
          <span class="pg-footer-version">v{extensionVersion}</span> ·{' '}
          {`${d.footer.static}${umami.enabled ? d.footer.statsUmami : d.footer.statsNone}`}
        </p>
        {
          (icp || police) && (
            <p class="pg-footer-beian">
              {icp && (
                <a href="https://beian.miit.gov.cn/" rel="noopener">
                  {icp}
                </a>
              )}
              {police && (
                <a href="https://beian.mps.gov.cn/" rel="noopener">
                  {police}
                </a>
              )}
            </p>
          )
        }
      </div>
    </footer>
  </body>
</html>
