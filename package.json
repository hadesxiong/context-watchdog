{
  "name": "paste-guard",
  "version": "1.0.0",
  "description": "AI对话前的本地数据脱敏浏览器插件，保护您的敏感信息",
  "license": "Apache-2.0",
  "author": "hadesxiong",
  "homepage": "https://github.com/hadesxiong/paste-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadesxiong/paste-guard.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && node scripts/postbuild.mjs chrome",
    "build:firefox": "vue-tsc && vite build --mode firefox && node scripts/postbuild.mjs firefox",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "probe:layout": "node scripts/probe-layout.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "site:dev": "astro dev --root apps/site",
    "site:build": "astro build --root apps/site",
    "site:preview": "astro preview --root apps/site",
    "site:check": "astro check --root apps/site",
    "site:evidence": "node scripts/site-evidence.mjs",
    "site:evidence:check": "node scripts/site-evidence.mjs --check"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "gliner": "^0.0.19",
    "onnxruntime-web": "1.19.2",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@crxjs/vite-plugin": "^2.7.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@vitejs/plugin-vue": "^6.0.8",
    "astro": "^7.4.0",
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.11"
  }
}
